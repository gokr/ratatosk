# Runtime state: server data, uploaded files, local build output.
var/
# Flutter/Dart build output
app/build/
app/.dart_tool/
app/.flutter-plugins-dependencies
app/linux/flutter/ephemeral/
app/android/.gradle/
app/ios/Pods/
app/**/GeneratedPluginRegistrant.*
# Local toolchain/scratch
*.log

# Deployment secrets for the container: the data key and the VAPID pair.
# Generated by deploy/gen-secrets.sh; never commit them. .env (client API keys)
# is ignored the same way.
ratatosk.env
.env
deploy/*.env

# var/tools holds the pinned code generators that `make setup` fetches.
# (var/ is already ignored wholesale; this line documents why it is fine.)
